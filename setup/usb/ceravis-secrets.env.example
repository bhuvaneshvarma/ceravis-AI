# CERAVIS install secrets — rename this file to ceravis-secrets.env and fill it in.
#
# KEEP THIS FILE PRIVATE: it holds the keys that let a device talk to the
# CERAVIS servers. It stays on this stick; the installer copies each value into
# a root-only file on the device and never prints it. Leave a line empty to
# skip it (it can be added later by running the installer again).

# The app server's X-API-Key (every call the edge makes to the app server).
CERAVIS_API_KEY=

# The fleet enrollment key (from the Fleet Management Server's fms.env).
FMS_ENROLL_KEY=

# The remote-access tunnel server (frps) and its token.
FRP_SERVER_ADDR=
FRP_TOKEN=
