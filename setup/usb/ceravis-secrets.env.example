# CERAVIS install secrets — fill this in ONCE on the PC that builds and sends
# the releases. It lives at ~/.ceravis/ceravis-secrets.env (outside the repo and
# outside OneDrive); setup/make_release.sh and setup/send_to_device.sh add it to
# a delivery, the device's installer copies each value into a root-only file
# and the copy on the device is deleted after a successful install.
#
# KEY=value, one per line. Spaces around '=' and "quotes" are fine. Never
# shared, never committed, never printed by the installer.

# ---- required: the install stops before changing anything without them ----
# The app server's X-API-Key (every call the edge makes to the app server).
CERAVIS_API_KEY=

# The remote-access tunnel server (frps) and its token.
FRP_SERVER_ADDR=
FRP_TOKEN=

# ---- recommended -----------------------------------------------------------
# The fleet enrollment key (from the Fleet Management Server's fms.env).
FMS_ENROLL_KEY=

# The password for the MANUAL reboot (8+ characters; stored only as a hash).
REBOOT_PASSWORD=

# The camera hotspot's password on EVERY device (8-63 characters). Empty: each
# device makes its own random one. Set: a device that already has a hotspot
# switches to it at the install — rejoin the hotspot (cameras too) with it.
HOTSPOT_PASSWORD=
