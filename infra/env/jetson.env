APP_NAME=CERAVIS
APP_VERSION=0.1.0
ENVIRONMENT=production
IS_PRODUCTION=true
LOG_LEVEL=INFO

# ---- Ingestion ------------------------------------------
TARGET_CAMERA_FPS=5
STREAM_FPS=10
READ_TIMEOUT_SECS=3
RECONNECT_DELAY_SECS=5
MAX_RECONNECT_DELAY_SECS=30
FRAME_STALE_SECS=5

# ---- Detection (YOLO26m) --------------------------------
# Paths are relative to the edge/ directory (the app's working directory).
DETECTION_WEIGHTS=yolo26m.pt
DETECTION_MODEL_PATH=models/detection/yolo26m.engine
DETECTION_CONFIDENCE_THRESHOLD=0.35
DETECTION_INPUT_SIZE=640
DETECTION_FPS=5

# ---- Pose (YOLO26m-Pose) --------------------------------
POSE_WEIGHTS=yolo26m-pose.pt
POSE_MODEL_PATH=models/pose/yolo26m-pose.engine
POSE_INPUT_SIZE=640
POSE_CONFIDENCE_THRESHOLD=0.35
POSE_FPS=2

# ---- ReID (FastReid BoT_R50) ----------------------------
# Provide an ONNX URL (exported from facebookresearch/fast-reid).
# Leave blank to keep ReID disabled.
FASTREID_ONNX_URL=
REID_MODEL_PATH=models/reid/fastreid_bot_r50.engine
REID_INPUT_HEIGHT=256
REID_INPUT_WIDTH=128
REID_EMBEDDING_DIM=2048
REID_FPS=2
REID_MATCH_THRESHOLD=0.55

# ---- Posture / Rules ------------------------------------
WALKING_MOTION_THRESHOLD_PIXELS=25
WALKING_MOTION_WINDOW_SECS=1.5
SITTING_MIN_SECS=5
STANDING_MIN_SECS=2
FALL_TORSO_ANGLE_DEG=60
FALL_CONFIRMATION_FRAMES=3
FALL_COOLDOWN_SECS=30

# ---- Storage --------------------------------------------
DATA_DIR=data
SQLITE_PATH=data/ceravis.db

# ---- Cloud / MQTT (leave blank to disable) --------------
MQTT_ENDPOINT=
MQTT_PORT=8883
MQTT_TOPIC_PREFIX=ceravis/edge
DEVICE_ID=edge-0001
