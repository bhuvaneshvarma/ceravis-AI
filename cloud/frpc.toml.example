# CERAVIS remote-access tunnel — frp CLIENT (runs on the Jetson edge).
#
# Copy to frpc.toml, fill in the ALL-CAPS values, then install with
# cloud/install_frpc.sh. It publishes, through the ONE shared cloud domain:
#   • the MediaMTX WebRTC live links   (127.0.0.1:8889)
#   • the edge API + admin pages       (127.0.0.1:8000, uvicorn)
# so both are reachable from anywhere over https, no per-house ports. Fully
# separate from ceravis.service — stop/disable this alone to turn remote access
# off; the AI pipeline is untouched.
#
# Fleet model: EVERY house uses the identical file below except its own EDGE_ID.
# frps routes by URL path: /<EDGE_ID>/… -> that house's MediaMTX; /api + /ui ->
# that house's uvicorn. Public links:
#   live : https://<DOMAIN>/<EDGE_ID>/<ROOM>/         (MediaMTX player page)
#   API  : https://<DOMAIN>/api/v1/…                  (open; edgeId in request)
#   pages: https://<DOMAIN>/ui/setup.html             (Caddy Basic-Auth prompt)
# EDGE_ID must equal edge/infra/env/jetson.env's EDGE_ID (the app server hands it
# back at account verification and the edge writes it there for you to copy).

serverAddr = "EC2_PUBLIC_IP_OR_DOMAIN"   # the AWS box's public IPv4 / domain
serverPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"   # must match frps.toml

log.to = "console"
log.level = "info"

# Live-stream tunnel — MediaMTX WebRTC, routed by the /<EDGE_ID> path prefix.
# frps hands the request (path intact) to MediaMTX; media then flows P2P over
# UDP and never returns through this tunnel.
[[proxies]]
name = "mediamtx-webrtc"
type = "http"
localIP = "127.0.0.1"
localPort = 8889                               # MediaMTX WebRTC signaling (WHEP)
customDomains = ["edgeai.ceravishealth.in"]    # the shared fleet DOMAIN
# Leave the marker comment intact: verifying the account rewrites THIS line
# automatically (ceravis-apply-edge-id) to the device's real edge_id.
locations = ["/EDGE_ID"]  # ceravis:edge-id — set automatically at account verify

# Edge CONTROL API — routed PER EDGE by the /<edge_id>/api path prefix, the SAME
# per-device key the live links use. frps routes ONLY by URL (never the request
# body), so in a multi-house fleet the control calls (PTZ, recordings, timeline,
# start/stop/restart, snapshot) MUST carry the edge_id in the PATH or they'd all
# collide on a shared /api and land on the wrong home. The edge strips this
# prefix internally (main._strip_fleet_edge_prefix) so its routes are unchanged.
# The edgeId in the request body stays as a second check (api/control_auth).
# App/backend calls it as: https://<DOMAIN>/<edge_id>/api/v1/…
[[proxies]]
name = "ceravis-api"
type = "http"
localIP = "127.0.0.1"
localPort = 8000                               # uvicorn (edge API)
customDomains = ["edgeai.ceravishealth.in"]
# Leave the marker comment intact: ceravis-apply-edge-id rewrites THIS line to
# ["/<edge_id>/api"] automatically at account verify + on every boot.
locations = ["/EDGE_ID/api"]  # ceravis:edge-id — set automatically at account verify

# Admin pages + setup JPEG stream — SHARED paths (/ui Basic-Auth at Caddy,
# /stream the wizard/monitor feed). These are single-operator setup/admin
# surfaces, used mostly on the LAN, so they stay on shared locations. `/api` is
# kept here too as a LEGACY alias so the pre-per-edge app keeps working during
# the switch-over. NOTE: `/api`, `/ui`, `/stream` are shared across the fleet —
# before adding a SECOND house, drop `/api` here (the per-edge proxy above owns
# it) so two edges never both claim the same `/api` route.
[[proxies]]
name = "ceravis-ui"
type = "http"
localIP = "127.0.0.1"
localPort = 8000
customDomains = ["edgeai.ceravishealth.in"]
locations = ["/api", "/ui", "/stream"]

# ---------------------------------------------------------------------------
# ⚠ Do NOT tunnel port 80 to the edge for Let's Encrypt. The cloud Caddy runs
#   the ACME client ON EC2 and needs EC2's own :80/:443, so an frpc "acme-http"
#   (80 -> edge) proxy would fight it. TLS is one shared cert on Caddy.
# ---------------------------------------------------------------------------
# OPTIONAL: SSH into THIS Jetson from anywhere over the fleet's ONE shared SSH
# port — no per-house remotePort. frps multiplexes every house's SSH through a
# single port (tcpmuxHTTPConnectPort in frps.toml) and routes by the HTTP CONNECT
# host = this device's edge_id, the SAME token that keys the live links. One port
# serves the whole fleet, disambiguated purely by edge_id.
#   Connect (any HTTP-CONNECT helper — ncat, corkscrew, socat):
#     ssh -o ProxyCommand="ncat --proxy EC2_IP:7001 --proxy-type http %h %p" <user>@EDGE_ID
# ⚠ Make the Jetson key-only FIRST (PasswordAuthentication no). The edge_id is the
#   ROUTING key, not authentication — the sshd keys are the auth. Open the frps
#   tcpmux port to admin IPs only in the EC2 security group.
# [[proxies]]
# name = "ceravis-ssh"
# type = "tcpmux"
# multiplexer = "httpconnect"
# localIP = "127.0.0.1"
# localPort = 22
# customDomains = ["EDGE_ID"]  # ceravis:ssh-edge-id — this device's edge_id (the CONNECT host)
#
# SIMPLER ALTERNATIVE (no shared port, no ProxyCommand): a plain tcp proxy with a
# UNIQUE remotePort per house — `ssh -p 2222 <user>@EC2_IP`. Swap the block above
# for: type="tcp", localPort=22, remotePort=2222 (unique per house), SG *My IP*.
