# CERAVIS live-stream tunnel — frp CLIENT (runs on the Jetson edge).
#
# Copy to frpc.toml, fill in the ALL-CAPS values, then install with
# cloud/install_frpc.sh. This publishes the edge's local MediaMTX WebRTC
# signaling (127.0.0.1:8889) through the shared cloud domain, so the live links
# become reachable from anywhere. Fully separate from ceravis.service — stop or
# disable this alone to turn remote access off; the AI pipeline is untouched.
#
# Fleet model: EVERY house uses the identical file below except its own EDGE_ID.
# frps routes by the /<EDGE_ID> URL path prefix, so one shared domain + one
# shared port serve the whole fleet — no per-house ports. The public link is
#   https://<DOMAIN>/<EDGE_ID>/<camera>/whep
# EDGE_ID must equal edge/infra/env/jetson.env's EDGE_ID (a long unguessable
# token — it is effectively the access key to this house's cameras).

serverAddr = "EC2_PUBLIC_IP_OR_DOMAIN"   # the AWS box's public IPv4 / domain
serverPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"   # must match frps.toml

log.to = "console"
log.level = "info"

# The one live-stream tunnel. type="http" so frps can route by URL path prefix.
#   customDomains — the shared fleet domain (Caddy terminates TLS for it on EC2).
#   locations     — this house's edge_id; frps forwards /<EDGE_ID>/... here.
# frps hands the request (path intact) to the local MediaMTX WebRTC port; media
# then flows P2P over UDP and never returns through this tunnel.
[[proxies]]
name = "mediamtx-webrtc"
type = "http"
localIP = "127.0.0.1"
localPort = 8889                             # MediaMTX WebRTC signaling (WHEP)
customDomains = ["edgeai.ceravishealth.in"]  # the shared fleet DOMAIN
locations = ["/EDGE_ID"]                      # this house's edge_id, e.g. /home-9f3c1e

# ---------------------------------------------------------------------------
# ⚠ Do NOT tunnel port 80 to the edge for Let's Encrypt. In the fleet model the
#   cloud Caddy runs the ACME client ON EC2 and needs EC2's own :80 and :443, so
#   an frpc "acme-http" (80 -> edge) proxy would fight Caddy for that port.
#   Remove any such proxy. TLS is one shared cert on Caddy for the whole fleet.
# ---------------------------------------------------------------------------
# OPTIONAL: reach this edge's admin pages (uvicorn :8000 — setup wizard,
# monitor, live wall) from anywhere. DISABLED by default on purpose.
#
# ⚠ SECURITY: the edge API has NO built-in authentication. This block puts frp
#   HTTP Basic Auth in front, and it MUST only be reachable from your IP. It
#   rides the SAME frps vhost as the live stream (vhostHTTPPort 8000), keyed by
#   host: the live links use the DOMAIN (via Caddy), this uses Host=<EC2_IP>.
#   In the EC2 security group open TCP 8000 to *My IP* only, then browse
#   http://EC2_IP:8000/ui/setup.html (the browser prompts for user/password).
# [[proxies]]
# name = "ceravis-admin"
# type = "http"
# localIP = "127.0.0.1"
# localPort = 8000
# customDomains = ["EC2_PUBLIC_IP"]          # your EC2 IP (NOT the fleet domain)
# httpUser = "admin"
# httpPassword = "CHANGE_ME_TO_A_STRONG_PASSWORD"
#
# ---------------------------------------------------------------------------
# OPTIONAL: SSH into the Jetson from anywhere (remote maintenance / setup).
#   ssh -p <remotePort> <jetson-user>@EC2_IP
# ⚠ Make Jetson SSH key-only first (PasswordAuthentication no). Give each house
#   a UNIQUE remotePort so they don't collide; SG source = *My IP* (or 0.0.0.0/0
#   only once it is truly key-only).
# [[proxies]]
# name = "ceravis-ssh"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 22
# remotePort = 2222                          # unique per house
