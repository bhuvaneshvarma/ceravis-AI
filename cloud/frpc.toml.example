# CERAVIS remote-access tunnel — frp CLIENT (runs on the Jetson edge).
#
# Copy to frpc.toml, fill in the ALL-CAPS values, then install with
# cloud/install_frpc.sh. It publishes, through the ONE shared cloud domain:
#   • the MediaMTX WebRTC live links   (127.0.0.1:8889)
#   • the edge API + admin pages       (127.0.0.1:8000, uvicorn)
# so both are reachable from anywhere over https, no per-house ports. Fully
# separate from ceravis.service — stop/disable this alone to turn remote access
# off; the AI pipeline is untouched.
#
# Fleet model: EVERY house uses the identical file below except its own EDGE_ID.
# frps routes by URL path: /<EDGE_ID>/… -> that house's MediaMTX; /api + /ui ->
# that house's uvicorn. Public links:
#   live : https://<DOMAIN>/<EDGE_ID>/<ROOM>/         (MediaMTX player page)
#   API  : https://<DOMAIN>/api/v1/…                  (open; edgeId in request)
#   pages: https://<DOMAIN>/ui/setup.html             (Caddy Basic-Auth prompt)
# EDGE_ID must equal edge/infra/env/jetson.env's EDGE_ID (the app server hands it
# back at account verification and the edge writes it there for you to copy).

serverAddr = "EC2_PUBLIC_IP_OR_DOMAIN"   # the AWS box's public IPv4 / domain
serverPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"   # must match frps.toml

log.to = "console"
log.level = "info"

# Live-stream tunnel — MediaMTX WebRTC, routed by the /<EDGE_ID> path prefix.
# frps hands the request (path intact) to MediaMTX; media then flows P2P over
# UDP and never returns through this tunnel.
[[proxies]]
name = "mediamtx-webrtc"
type = "http"
localIP = "127.0.0.1"
localPort = 8889                               # MediaMTX WebRTC signaling (WHEP)
customDomains = ["edgeai.ceravishealth.in"]    # the shared fleet DOMAIN
# Leave the marker comment intact: verifying the account rewrites THIS line
# automatically (ceravis-apply-edge-id) to the device's real edge_id.
locations = ["/EDGE_ID"]  # ceravis:edge-id — set automatically at account verify

# Edge uvicorn — EVERYTHING (API + admin pages + setup stream) routed PER EDGE
# under the ONE /<edge_id> path prefix, the SAME per-device key the live links
# use. frps routes ONLY by URL (never the request body), so every call carries
# the edge_id in the PATH and can only ever reach THIS home — no shared route can
# collide across houses. The edge strips the prefix internally
# (main._strip_fleet_edge_prefix), so uvicorn serves its normal /api, /ui,
# /stream. The edgeId in the request body stays as a second check (control_auth).
#   API   : https://<DOMAIN>/<edge_id>/api/v1/…
#   pages : https://<DOMAIN>/<edge_id>/ui/setup.html   (Basic-Auth at Caddy)
#   stream: https://<DOMAIN>/<edge_id>/stream/<cam>    (setup JPEG WebSocket)
# frps picks the LONGEST matching location, so /<edge_id>/api|ui|stream go here
# to uvicorn while /<edge_id>/<ROOM>/whep falls to the mediamtx-webrtc proxy.
[[proxies]]
name = "ceravis-api"
type = "http"
localIP = "127.0.0.1"
localPort = 8000                               # uvicorn (edge API + pages + stream)
customDomains = ["edgeai.ceravishealth.in"]
# Leave the marker comment intact: ceravis-apply-edge-id rewrites THIS line to
# ["/<edge_id>/api", "/<edge_id>/ui", "/<edge_id>/stream"] automatically at
# account verify + on every boot.
locations = ["/EDGE_ID/api", "/EDGE_ID/ui", "/EDGE_ID/stream"]  # ceravis:edge-id — set automatically at account verify

# ---------------------------------------------------------------------------
# ⚠ Do NOT tunnel port 80 to the edge for Let's Encrypt. The cloud Caddy runs
#   the ACME client ON EC2 and needs EC2's own :80/:443, so an frpc "acme-http"
#   (80 -> edge) proxy would fight it. TLS is one shared cert on Caddy.
# ---------------------------------------------------------------------------
# SSH into THIS Jetson from anywhere over the fleet's ONE shared SSH port — no
# per-house remotePort. frps multiplexes every house's SSH through a single port
# (tcpmuxHTTPConnectPort in frps.toml) and routes by the HTTP CONNECT host = this
# device's edge_id, the SAME token that keys the live links. One port serves the
# whole fleet, disambiguated purely by edge_id — adding a house costs nothing.
#
# Connect from the admin machine — no install needed, stdlib Python only:
#   ssh -o ProxyCommand="python cloud/fleet_ssh_proxy.py --via EC2_IP:7001 %h %p" \
#       <user>@<edge_id>
#   test it first:  python cloud/fleet_ssh_proxy.py --via EC2_IP:7001 --check <edge_id>
# (ncat/corkscrew work too, if installed: --proxy EC2_IP:7001 --proxy-type http.)
#
# ⚠ Make the Jetson key-only FIRST (PasswordAuthentication no). The edge_id is the
#   ROUTING key, not authentication — the sshd keys are the auth. Open the frps
#   tcpmux port to admin IPs only in the EC2 security group. To opt a house out of
#   remote SSH entirely, comment this block out (the rest keeps working).
# Note: the session rides INSIDE frpc, so anything that restarts frpc (account
# verify, ceravis-apply-edge-id) drops it — just reconnect. The LAN/console path
# is unaffected, which is what keeps this recoverable.
[[proxies]]
name = "ceravis-ssh"
type = "tcpmux"
multiplexer = "httpconnect"
localIP = "127.0.0.1"
localPort = 22
# Leave the marker comment intact: ceravis-apply-edge-id rewrites THIS line to the
# device's real edge_id at account verify + on every boot, exactly like the two
# proxies above. NO leading slash here — a CONNECT host is a hostname, not a path.
customDomains = ["EDGE_ID"]  # ceravis:ssh-edge-id — set automatically at account verify
