# CERAVIS edge — the unit ceravis-reboot.timer triggers.
# Installed by setup/install_reboot_timer.sh, which substitutes the real repo
# path. Don't edit the /etc copy by hand; re-run the installer.
[Unit]
Description=CERAVIS nightly reboot (safety-checked)
# If the network is going down we are already on our way out; don't race it.
After=network-online.target

[Service]
Type=oneshot
# Runs as root because it ends in `systemctl reboot`. It does NOT need the
# reboot password: nobody is present at 03:00, and the authorisation here is
# that root owns the timer. The password guards the MANUAL path, where a caller
# is asserting they are allowed to take a care device offline.
User=root
WorkingDirectory=/home/ceravis/ceravis2/edge
# NOTE the leading '-': a MISSING env file must not stop the service. systemd
# treats a bare EnvironmentFile= as fatal and reports it as "unavailable
# resources or another system error", which names nothing and sends you
# hunting the wrong thing. jetson.env is generated by setup/setup.sh and is
# gitignored, so a fresh clone legitimately has none yet. The app does not
# depend on this line either way: config/settings.py loads the same file
# directly through pydantic and falls back to defaults when it is absent.
-EnvironmentFile=/home/ceravis/ceravis2/edge/infra/env/jetson.env
ExecStart=/usr/bin/python3 /home/ceravis/ceravis2/edge/tools/scheduled_reboot.py
# The script asks the running service whether it is safe, and skips the night if
# an alert is still queued. A non-zero exit is a real failure worth seeing in
# `systemctl status`, so no "-" prefix here.
TimeoutStartSec=120
