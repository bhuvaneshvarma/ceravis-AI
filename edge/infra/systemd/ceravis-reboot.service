# CERAVIS edge — the unit ceravis-reboot.timer triggers.
# Installed by setup/install_reboot_timer.sh, which substitutes the real repo
# path. Don't edit the /etc copy by hand; re-run the installer.
[Unit]
Description=CERAVIS nightly reboot (safety-checked)
# If the network is going down we are already on our way out; don't race it.
After=network-online.target
# This board has no battery-backed RTC — it boots at 1970 until NTP corrects it.
# Ordering after time-sync.target means this service starts only once the clock
# is disciplined, so scheduled_reboot.py sees the REAL time (it double-checks the
# sync flag + the window itself, in case the timer fired early on a clock step).
# Requires systemd-time-wait-sync to be enabled for time-sync.target to actually
# mean "synchronised" — setup/install_reboot_timer.sh enables it.
After=time-sync.target
Wants=time-sync.target

[Service]
Type=oneshot
# Runs as the SERVICE ACCOUNT (ceravis), NOT root — installer substitutes the
# real user. This is load-bearing, and running as root was a real bug: the app's
# Python deps (pydantic_settings, …) are installed `pip install --user` under the
# service account, so root's interpreter can't import them and the script died at
# `import settings` before evaluating a single gate — the timer fired nightly and
# nothing happened. Running as this user also keeps edge/data/ files (marker,
# call_log) owned by the app instead of root. The reboot itself is authorised by
# the NOPASSWD sudoers rule granted to THIS user (see install_reboot_timer.sh) and
# invoked via settings.reboot_command = "sudo -n /bin/systemctl reboot" — the same
# command and rule the manual API path uses. No reboot password: nobody is present
# at 03:00; the password guards only the MANUAL path.
User=ceravis
WorkingDirectory=/home/ceravis/ceravis2/edge
# NOTE the '-' on the VALUE (EnvironmentFile=-/path): a MISSING env file must not
# stop the service. The '-' belongs on the path, NOT the key — `-EnvironmentFile=`
# is an unknown key that systemd rejects and IGNORES (with a journal warning),
# which silently drops the file. jetson.env is generated by setup/setup.sh and is
# gitignored, so a fresh clone legitimately has none yet. The app does not depend
# on this line either way: config/settings.py loads the same file directly through
# pydantic and falls back to defaults when it is absent.
EnvironmentFile=-/home/ceravis/ceravis2/edge/infra/env/jetson.env
ExecStart=/usr/bin/python3 /home/ceravis/ceravis2/edge/tools/scheduled_reboot.py
# The script asks the running service whether it is safe, and skips the night if
# an alert is still queued. A non-zero exit is a real failure worth seeing in
# `systemctl status`, so no "-" prefix here.
# A refresh night restarts the cameras one at a time (each waits for its
# stream to return) before restarting the service — minutes, not seconds.
TimeoutStartSec=900
