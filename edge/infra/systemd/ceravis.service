# CERAVIS edge — native systemd unit (no Docker).
# Installed by setup/install_service.sh, which substitutes the real repo
# path and user automatically. Don't edit the /etc copy by hand; re-run
# the installer instead.
[Unit]
Description=CERAVIS Edge AI (native, JetPack stack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ceravis
WorkingDirectory=/home/ceravis/ceravis2/edge
# NOTE the '-' on the VALUE (EnvironmentFile=-/path): a MISSING env file must not
# stop the service. The '-' belongs on the path, NOT the key — `-EnvironmentFile=`
# is an unknown key that systemd rejects and IGNORES (with a journal warning),
# which silently drops the file. jetson.env is generated by setup/setup.sh and is
# gitignored, so a fresh clone legitimately has none yet. The app does not depend
# on this line either way: config/settings.py loads the same file directly through
# pydantic and falls back to defaults when it is absent.
EnvironmentFile=-/home/ceravis/ceravis2/edge/infra/env/jetson.env
# Rebuild engines if missing (skips instantly when already built). Runs from the
# WorkingDirectory (edge) so model paths resolve; "-" prefix: a failure here must
# not block the API from starting.
ExecStartPre=-/usr/bin/python3 /home/ceravis/ceravis2/setup/export_models.py
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
# An engine rebuild in ExecStartPre can take several minutes — don't let
# systemd's default 90 s start timeout kill the service mid-build.
TimeoutStartSec=900
# SHUTDOWN ORDER BELONGS TO THE APP. The default KillMode=control-group sends
# SIGTERM to EVERY process in the service at the same instant — MediaMTX and its
# FFmpeg children included — so the backbone died underneath a still-running
# pipeline (open recording cut, a false "Media backbone DOWN" alarm on every
# reboot, and the supervisor respawning MediaMTX into a dying service). `mixed`
# signals ONLY the app; Pipeline.stop() then closes recording first and stops
# MediaMTX last (gracefully, SIGINT). Anything still alive after the app exits
# is SIGKILLed, so nothing can be orphaned.
KillMode=mixed
# Bound the wait on open connections (talk-back / live sockets) so the ordered
# shutdown above actually runs, instead of being SIGKILLed at the stop timeout.
# An env var, not a CLI flag: a uvicorn too old to know it ignores it harmlessly.
Environment=UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=10
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
# The nightly REFRESH (maintenance/refresh.py) ends the service with 75 after
# a clean shutdown: restart it, and do not record that as a failure.
RestartForceExitStatus=75
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
