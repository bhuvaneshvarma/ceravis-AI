# CERAVIS edge — native systemd unit (no Docker).
# Installed by setup/install_service.sh, which substitutes the real repo
# path and user automatically. Don't edit the /etc copy by hand; re-run
# the installer instead.
[Unit]
Description=CERAVIS Edge AI (native, JetPack stack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ceravis
WorkingDirectory=/home/ceravis/ceravis2/edge
# NOTE the leading '-': a MISSING env file must not stop the service. systemd
# treats a bare EnvironmentFile= as fatal and reports it as "unavailable
# resources or another system error", which names nothing and sends you
# hunting the wrong thing. jetson.env is generated by setup/setup.sh and is
# gitignored, so a fresh clone legitimately has none yet. The app does not
# depend on this line either way: config/settings.py loads the same file
# directly through pydantic and falls back to defaults when it is absent.
-EnvironmentFile=/home/ceravis/ceravis2/edge/infra/env/jetson.env
# Rebuild engines if missing (skips instantly when already built). Runs from the
# WorkingDirectory (edge) so model paths resolve; "-" prefix: a failure here must
# not block the API from starting.
ExecStartPre=-/usr/bin/python3 /home/ceravis/ceravis2/setup/export_models.py
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000
# An engine rebuild in ExecStartPre can take several minutes — don't let
# systemd's default 90 s start timeout kill the service mid-build.
TimeoutStartSec=900
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
