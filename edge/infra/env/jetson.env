APP_NAME=CERAVIS
APP_VERSION=0.1.0
ENVIRONMENT=production
IS_PRODUCTION=true
LOG_LEVEL=INFO

# ---- Ingestion ------------------------------------------
# Capture rate is decoupled from inference (latest-frame buffer). This feeds the
# AI ONLY — no viewer is served from it — and nothing samples it faster than pose
# at 12 fps (detection/tracking 10, ReID 3, rules 1). 15 is therefore a ceiling
# with headroom, not a limitation: every consumer still gets a frame <=66 ms old,
# and we stop decoding + BGR-converting ~10 extra 4K frames a second per camera
# that were only ever overwritten unread. 0 = uncapped (native rate).
TARGET_CAMERA_FPS=15
READ_TIMEOUT_SECS=3
RECONNECT_DELAY_SECS=5
MAX_RECONNECT_DELAY_SECS=30
FRAME_STALE_SECS=5

# ---- Detection (YOLO26m) --------------------------------
# Paths are relative to the edge/ directory (the app's working directory).
# Detection scans the full frame (heaviest stage). 10 fps for 1-2 cameras;
# drop to 6-8 for 3-4 cameras to keep GPU headroom.
DETECTION_WEIGHTS=yolo26m.pt
DETECTION_MODEL_PATH=models/detection/yolo26m.engine
DETECTION_CONFIDENCE_THRESHOLD=0.35
DETECTION_INPUT_SIZE=640
DETECTION_FPS=10

# ---- Pose (YOLO26m-Pose) --------------------------------
# Pose is idle-gated (runs only when a person is tracked) and target-focused
# (crops the locked target once ReID is enabled).
POSE_WEIGHTS=yolo26m-pose.pt
POSE_MODEL_PATH=models/pose/yolo26m-pose.engine
POSE_INPUT_SIZE=640
POSE_CONFIDENCE_THRESHOLD=0.35
POSE_FPS=12

# ---- ReID (OSNet by default) ----------------------------
# Build the engine with: bash scripts/export_reid.sh  (OSNet x1_0, dim 512).
# For FastReid BoT_R50 instead: drop its ONNX at REID_ONNX_PATH and set
# REID_EMBEDDING_DIM=2048. REID_ONNX_URL can point at a prebuilt ONNX.
REID_MODEL_NAME=osnet_x1_0
REID_MODEL_PATH=models/reid/reid.engine
REID_ONNX_PATH=models/reid/reid.onnx
REID_ONNX_URL=
REID_INPUT_HEIGHT=256
REID_INPUT_WIDTH=128
REID_EMBEDDING_DIM=512
REID_FPS=3
REID_MATCH_THRESHOLD=0.55

# ---- Adaptive ReID (online learning) --------------------
# Captures novel body embeddings of the matched target live (vectors only) so
# the recipient keeps matching through clothing changes. Enrolled embeddings
# are never overwritten. Set REID_ADAPTIVE_ENABLED=false to disable.
REID_ADAPTIVE_ENABLED=true
REID_ADAPTIVE_MAX=100
REID_ADAPTIVE_MIN_SCORE=0.70
REID_ADAPTIVE_DEDUP_COS=0.92
REID_ADAPTIVE_MIN_INTERVAL_SECS=4
REID_ADAPTIVE_REBUILD_SECS=5

# ---- Pipeline focus / efficiency ------------------------
CROP_PADDING_FRAC=0.08
TARGET_ONLY_POSE=true
TARGET_LOCK_TTL_SECS=5

# ---- Posture / Rules ------------------------------------
# Walking is scale-normalized + confirmed over several frames so a chair
# swivel or small turn is not mistaken for walking. Raise BODY_FRACTION or
# CONFIRM_FRAMES to make walking detection stricter.
WALKING_MOTION_WINDOW_SECS=1.5
WALKING_MOTION_BODY_FRACTION=0.6
WALKING_CONFIRM_FRAMES=3
WALKING_MIN_PIXELS=12
# Sit<->stand only flips when head motion corroborates (rises to stand, falls
# to sit), so a small seated shift / legs leaving the frame can't flip it.
POSTURE_TRANSITION_HEAD_FRAC=0.15
POSTURE_TRANSITION_CONFIRM_FRAMES=3
FALL_TORSO_ANGLE_DEG=60
FALL_CONFIRMATION_FRAMES=3
FALL_COOLDOWN_SECS=30

# ---- Storage --------------------------------------------
DATA_DIR=data
SQLITE_PATH=data/ceravis.db

# ---- Events / alerts ------------------------------------
# Snapshots saved S3-mirrored: events_dir/<device_id>/<date>/<event_id>.jpg.
# A fall whose foot point is inside a zone named with one of REST_ZONE_KEYWORDS
# is logged as intentional lying (no alarm) instead of a critical fall.
EVENTS_DIR=data/events
EVENT_SNAPSHOT_QUALITY=80
# Rolling retention for the device's own event record: rows in ceravis.db and
# the snapshot JPEGs they point at are both expired once older than this many
# days (0 = keep forever). A still is written for EVERY event, so without this
# data/events grows until the disk is full. Swept hourly by the event writer.
EVENT_RETENTION_DAYS=14
REST_ZONE_KEYWORDS=bed,couch,sofa,recliner,chair,bench,lounge
# Room-to-room moves (LocationRule): the previous room stays valid as the
# transition origin across a sighting gap (uncovered hallway) this long.
ROOM_TRANSITION_MAX_GAP_SECS=600

# ---- CERAVIS application server (cloud) -----------------
# The web address of your application server. Setup sends the operator's email
# here to verify it (POST {BASE_URL}/v1/ai/userDetails). Leave blank to run the
# device standalone. Every call also sends the API key as the X-API-Key header
# (baked into settings.py; uncomment below to rotate it without touching code).
CERAVIS_API_BASE_URL=https://app.ceravishealth.in/ch
# CERAVIS_API_KEY=sk-...

# ---- Cloud upload queue (offline-safe) ------------------
# Alerts, snapshots and fall clips are written to a durable SQLite queue and
# sent from there FALLS FIRST, then oldest first. A network outage delays
# delivery instead of losing the incident: the device keeps detecting, recording
# and serving LAN live view throughout, and the queue drains itself the moment
# the link is back — the fall ahead of the ambient backlog that piled up in
# front of it. Watch it: ceravis-status, or the monitor's Cloud sync console.
# Detail: GET /api/v1/cloud/outbox
#
# Disk is given back as it goes: a job's image/clip is deleted only when its
# call SUCCEEDS, so nothing generated is ever discarded before it lands and a
# delivering device holds nothing.
#
# NOTHING IS DROPPED FOR AN ERROR. A dead link, a 5xx, a 4xx (a server mid-DB-
# swap returning 400), even 401/404 — every failure just retries. A failing job
# steps aside so it never blocks the queue, and 401/403/404/413 also raise a
# loud "needs attention" note (console + /system/status) since those usually
# mean a real config problem. The ONE thing that ever drops a job is the age
# window below: undelivered for this long -> dropped, so a server that never
# returns cannot fill the disk forever. 48h covers a long weekend of downtime.
OUTBOX_WINDOW_SECS=172800
# Disk-safety caps (last resort if the volume genuinely fills during a long
# outage): eviction is ambient-wallpaper first, never a fall or alert.
OUTBOX_MAX_ITEMS=5000
OUTBOX_MAX_BLOB_MB=1024
# Retry backoff cap. The status heartbeat drains the queue the instant the
# server answers; this is the fallback cadence if the heartbeat is disabled.
OUTBOX_BACKOFF_MAX_SECS=30

DEVICE_ID=edge-0001

# ---- MediaMTX media backbone ----------------------------
# MediaMTX runs as a CHILD of ceravis.service (one unit). It connects to each
# camera once and fans the compressed stream out with no re-encoding: the AI
# reads rtsp://127.0.0.1:8554/<cam>; browsers get WebRTC :8889 / HLS :8888
# over HTTPS (self-signed cert from setup/install_mediamtx.sh); recordings go
# to disk. Install with: bash setup/install_mediamtx.sh
MEDIAMTX_BINARY=/usr/local/bin/mediamtx
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_API_PORT=9997
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
# Jitterbuffer depth for the AI's loopback RTSP pull (ms). 0 = NO BUFFER, which
# is correct: loopback interleaved TCP delivers every packet in order with no
# loss, so there is no jitter to absorb and any value above zero is pure added
# delay between the camera and YOLO. MediaMTX already absorbed the real network
# jitter on the camera side.
RTSP_LATENCY_MS=0

# ---- Fleet remote live-stream (see cloud/README.md) ------
# The shared cloud domain (Caddy TLS) + STUN are pre-set below, so every house
# ships fleet-ready. The ONLY per-house value you must fill is EDGE_ID.
#
# EDGE_ID — this house's routing token (the deviceToken from account
# verification). Normally you leave this BLANK.
#
# The device stores the verified token in data/account.json, which is
# gitignored and is what effective_edge_id() reads FIRST. It also pushes the
# same value into cloud/frpc.toml and restarts the tunnel by itself. Nothing
# writes to THIS file at runtime, which is why `git pull` never collides with
# it.
#
# Set it here only to pin a token by hand (a LAN-only rig, or a device you are
# re-keying before verification). A value here is used when account.json has
# none. It must match locations = ["/<edge_id>"] in cloud/frpc.toml.
EDGE_ID=
DEVICE_STREAM_BASE=https://edgeai.ceravishealth.in
MEDIAMTX_STUN_SERVER=stun:stun.l.google.com:19302

# ---- Which camera profile VIEWERS get --------------------------------
# Decided ONCE, at registration: the setup wizard pre-selects the H.264 profile
# NEAREST this height and stores its RTSP URL. Nothing on the camera is ever
# rewritten - we only choose among the profiles it already offers, and the
# operator can override the pick in the wizard.
#
# "Nearest", not "largest at or below": a camera offering 1440p and 360p, asked
# for 1080p, must give 1440p - the at-or-below rule hands back 360p.
#
# This stream feeds the public live links, the /ui tiles and the recordings, so
# H.264 is mandatory: no browser decodes HEVC over WebRTC. On a camera whose
# BIGGEST stream is HEVC, the AI separately reads that bigger one so tracking
# keeps its reach - that is the only case where a camera is dialled twice.
CAMERA_PREFERRED_HEIGHT=1080

# ---- Recording (person-triggered) ------------------------
# Records ONLY while YOLO sees a person (+ post-roll), as MPEG-TS segments of
# the camera's MAIN stream at full native quality — remux only, no CPU
# transcode, and no second connection to the camera (the one MediaMTX already
# holds for live view and the AI is what gets written). Segments self-delete
# after RECORD_RETENTION_HOURS, giving a rolling window of "who was in frame".
# Playback: GET /api/v1/recordings/{camera}/timeline + /playback.m3u8
RECORD_ENABLED=true
RECORD_DIR=data/recordings
RECORD_SEGMENT_SECS=15
RECORD_RETENTION_HOURS=12
RECORD_POST_ROLL_SECS=15

# ---- WiFi cameras: discovery + hotspot -------------------
# ONVIF WS-Discovery scan window (Setup -> "Find cameras").
ONVIF_DISCOVERY_SECS=3
# Hotspot (Jetson as the cameras' WiFi AP; hotspot.html). Blank interface =
# auto-pick the first WiFi adapter. Needs the polkit rule from
# setup/install_hotspot.sh so the service user may drive NetworkManager.
HOTSPOT_INTERFACE=
HOTSPOT_CONNECTION_NAME=ceravis-hotspot

# ---- Nightly reboot -------------------------------------
# systemd owns the SCHEDULE (ceravis-reboot.timer, 03:00 + up to 1h random).
# These describe it to the API and drive the safety/authorisation behaviour.
REBOOT_SCHEDULED_ENABLED=true
REBOOT_WINDOW_START_HOUR=3
# Defer the nightly reboot when a fall alert is still queued for the cloud.
REBOOT_DEFER_ON_PENDING_ALERTS=true
# Manual-reboot password lockout (set the password with
# python3 setup/set_reboot_password.py).
REBOOT_MAX_ATTEMPTS=5
REBOOT_LOCKOUT_SECS=300
REBOOT_DELAY_SECS=3
