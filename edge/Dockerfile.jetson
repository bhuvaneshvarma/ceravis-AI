# =============================================================
# JETSON DOCKERFILE — NVIDIA Jetson Orin Nano Super, JetPack 6.1 (CUDA 12.6)
# =============================================================
#
# Base: dustynv/l4t-pytorch:r36.4.0 — a tested Jetson image that already
#   ships PyTorch + torchvision + torchaudio built for CUDA 12.6, plus CUDA
#   and cuDNN. TensorRT is provided to the container at runtime by the
#   `nvidia` container runtime (see docker-compose.jetson.yml: runtime: nvidia).
#
# This deliberately avoids hand-installing torch/torchvision (the wheel URLs
# 404 and the source compile OOMs on 8 GB) — the base image owns that stack.
# We only add the web/AI app dependencies on top.
#
# Models (TensorRT .engine files) are auto-built at first container start by
#   scripts/export_models.py and persisted to the /models volume.
#
# Build on the device:
#   docker compose -f docker-compose.jetson.yml build

FROM dustynv/l4t-pytorch:r36.4.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# ---- System deps ------------------------------------------------
# build-essential/cmake/swig/git: source builds for faiss / pycuda on ARM64.
# gstreamer plugins: rtspsrc + nvv4l2decoder (HW) and avdec_* (SW) decode.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        swig \
        git \
        pkg-config \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
        libgstrtspserver-1.0-0 \
        libsm6 libxext6 libglib2.0-0 libgl1 \
        wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Verify the base image's torch stack (no reinstall) ---------
RUN python3 -c "import torch, torchvision; print('torch', torch.__version__, '| cuda', torch.version.cuda, '| torchvision', torchvision.__version__); assert torch.version.cuda is not None, 'base image torch is not a CUDA build'"

# ---- OpenCV: only install if the base image lacks it ------------
# Ubuntu's python3-opencv is built with GStreamer support. Installing it
# conditionally avoids clobbering any CUDA-enabled cv2 already in the base.
RUN python3 -c "import cv2; print('opencv present', cv2.__version__)" \
    || ( apt-get update \
         && apt-get install -y --no-install-recommends python3-opencv \
         && rm -rf /var/lib/apt/lists/* )

# ---- App Python deps (torch/torchvision NOT listed; already present) ----
RUN pip3 install --no-cache-dir --upgrade pip
COPY requirements.txt ./
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# ---- App ------------------------------------------------------
COPY . .
RUN chmod +x /app/entrypoint.sh

EXPOSE 8000

# Models live in a host-mounted volume so engines persist across rebuilds.
VOLUME ["/models", "/app/data"]

ENTRYPOINT ["/app/entrypoint.sh"]
