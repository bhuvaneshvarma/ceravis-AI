# =============================================================
# JETSON DOCKERFILE — NVIDIA Jetson Orin Nano Super, JetPack 6.x
# =============================================================
#
# Uses the JetPack-provided versions of CUDA, TensorRT, PyCUDA, OpenCV.
# Models (TensorRT .engine files) are auto-built at first container
# start by scripts/export_models.py and persisted to the /models volume.
#
# Build on the device:
#   docker build -f Dockerfile.jetson -t ceravis-edge:jetson .
# Run via docker-compose.jetson.yml.

FROM nvcr.io/nvidia/l4t-jetpack:r36.3.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# ---- System deps (JetPack provides CUDA + TensorRT) ------------
# python3-opencv ships with GStreamer + CUDA support.
# build-essential + cmake + swig: needed if pycuda/faiss build from source on ARM64.
# gstreamer plugins enable rtspsrc + nvv4l2decoder hardware path.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-dev \
        python3-numpy \
        python3-opencv \
        build-essential \
        cmake \
        swig \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-libav \
        libgstrtspserver-1.0-0 \
        libsm6 libxext6 libglib2.0-0 \
        wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Python deps -----------------------------------------------
# Upgrade pip first — the base image ships pip 22.x which lacks
# newer wheel metadata support.
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# PyTorch on Jetson MUST be the CUDA-enabled aarch64 wheel built by NVIDIA.
# The generic PyPI torch is CPU/CUDA-13 only and reports cuda.is_available()=False.
# Strategy:
#   1. Install torch's pure-python deps from PyPI (so the Jetson index only
#      needs to serve torch + torchvision themselves).
#   2. Install torch/torchvision from the jetson-ai-lab index for JetPack 6 /
#      CUDA 12.6 (cu126 = the driver version reported by `nvcc`/tegrastats).
#      --index-url (not --extra-index-url) forces the Jetson wheels and avoids
#      pip "upgrading" to a newer-but-broken PyPI build.
RUN pip3 install --no-cache-dir \
        filelock typing-extensions sympy networkx jinja2 fsspec mpmath pillow
RUN pip3 install --no-cache-dir \
        --index-url https://pypi.jetson-ai-lab.dev/jp6/cu126 \
        torch torchvision

# Sanity-check the wheel at build time. We check the CUDA *build* version
# (not cuda.is_available(), since the GPU isn't attached during `docker build`)
# to confirm we got a CUDA wheel and not the CPU/PyPI one.
RUN python3 -c "import torch; v=torch.version.cuda; print('torch', torch.__version__, 'built for CUDA', v); assert v is not None, 'CPU-only torch wheel — wrong index'"

COPY requirements.txt ./
RUN pip3 install --no-cache-dir -r requirements.txt

# ---- App ------------------------------------------------------
COPY . .
RUN chmod +x /app/entrypoint.sh

EXPOSE 8000

# Models live in a host-mounted volume so engines persist across rebuilds.
VOLUME ["/models", "/app/data"]

ENTRYPOINT ["/app/entrypoint.sh"]
