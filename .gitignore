# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
.env/

# Models — engines are device-specific, never commit
models/**/*.engine
models/**/*.onnx
models/**/*.pt
models/**/*.trt
edge/models/
edge/*.pt

# Runtime data: EVERYTHING the device writes under edge/data stays out of git —
# keys (local.key), face photos (recipients/), sessions, recordings, camera
# credentials (cameras.json), the account, talk-back hashes, the outbox, logs.
# One rule, so a new data file can never be committed by accident.
edge/data/*
!edge/data/cameras.example.json

# A device's real tunnel config (holds the frp token); the .example is tracked.
cloud/frpc.toml

# Docker / logs
*.log

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local-only (never commit): user report, root memory index, stray root data
/CERAVIS_System_Status_Report.xlsx
/MEMORY.md
/data/
/TALKBACK_INTEGRATION_GUIDE.md
# The API/architecture manuals live under docs/. Two of them are deliberately
# LOCAL ONLY — kept in the working tree, never committed.
/docs/identity-architecture.md
/docs/ai-pipeline-reference.md
/docs/ui-architecture.md
/docs/edge-wifi-health-notes.md
# Local ONVIF capability dumps (tools/onvif_dump) — camera-specific, may contain
# usernames/network details; a review artifact, never committed.
camerainfo/

# Release bundles built by setup/make_release.sh
dist/

# Claude Code session settings and rules: kept on each machine, never in the repo
.claude/
