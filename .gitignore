# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
.env/

# Models — engines are device-specific, never commit
models/**/*.engine
models/**/*.onnx
models/**/*.pt
models/**/*.trt
edge/models/
edge/*.pt

# Runtime data
edge/data/ceravis.db*
edge/data/recipients/*/photos/*
edge/data/recipients/*/videos/*

# Live camera config — contains real RTSP credentials, never commit
edge/data/cameras.json

# Docker / logs
*.log

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Cloud switch runtime state (device-local)
edge/data/cloud_mode.json
edge/data/cloud_outbox/

# Local-only (never commit): user report, root memory index, stray root data
/CERAVIS_System_Status_Report.xlsx
/MEMORY.md
/data/
