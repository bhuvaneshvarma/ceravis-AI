# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual envs
venv/
.venv/
.env/

# Models — engines are device-specific, never commit
models/**/*.engine
models/**/*.onnx
models/**/*.pt
models/**/*.trt
edge/models/
edge/*.pt

# Runtime data
edge/data/ceravis.db*
edge/data/recipients/*/photos/*
edge/data/recipients/*/videos/*

# Media backbone runtime state (generated config, TLS cert, recordings)
edge/data/mediamtx.yml
edge/data/certs/
edge/data/recordings/

# Cloud call log (monitor sync console runtime state)
edge/data/cloud_calls.jsonl

# Recording on/off runtime state (monitor button)
edge/data/recording_mode.json

# Live camera config — contains real RTSP credentials, never commit
edge/data/cameras.json

# Per-install runtime config — never ship a seeded/example copy
edge/data/zones.json
edge/data/account.json
edge/data/ceravis_api_wire.jsonl

# Docker / logs
*.log

# Editors
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local-only (never commit): user report, root memory index, stray root data
/CERAVIS_System_Status_Report.xlsx
/MEMORY.md
/data/
/recording-playback-api.md
# Local ONVIF capability dumps (tools/onvif_dump) — camera-specific, may contain
# usernames/network details; a review artifact, never committed.
camerainfo/
